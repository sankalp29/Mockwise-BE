# Copy to application-local.yml (gitignored) and adjust.
# Run: SPRING_PROFILES_ACTIVE=dev,local ./mvnw spring-boot:run
spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/mockwise_local
    username: YOUR_MAC_USERNAME
    password:
    driver-class-name: org.postgresql.Driver
  jpa:
    hibernate:
      ddl-auto: update
    database-platform: org.hibernate.dialect.PostgreSQLDialect
  flyway:
    enabled: false

supabase:
  url: http://localhost
  anon:
    key: local-dev-anon
  service:
    key: local-dev-service

claude:
  api:
    key:
