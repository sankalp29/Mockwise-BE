# =============================================================================
# application-local-secrets.yml.example — template for machine-only secrets
# =============================================================================
# 1. Copy:
#      cp src/main/resources/application-local-secrets.yml.example \
#         src/main/resources/application-local-secrets.yml
# 2. Fill values from Supabase → Project Settings → API + Database.
# 3. Never commit application-local-secrets.yml (gitignored).
# 4. Loaded with profile "local" via spring.profiles.group in application.yml.
#
# Use the Session pooler connection string (not direct db.<ref>:5432).
# Direct host is often IPv6-only → "No route to host" → Hikari total=0 timeouts.
# =============================================================================

spring:
  datasource:
    # Dashboard → Database → Connect → Session mode (port 6543)
    # Username: postgres.<PROJECT_REF>
    url: jdbc:postgresql://aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
    username: postgres.YOUR_PROJECT_REF
    password: "YOUR_DATABASE_PASSWORD"
    driver-class-name: org.postgresql.Driver

supabase:
  # Project Settings → API
  url: https://YOUR_PROJECT_REF.supabase.co
  anon:
    key: eyJ...anon...
  service:
    key: eyJ...service_role...

# claude:
#   api:
#     key: sk-ant-...
